    "text": "import { HealthCheck, HealthStatus, LivenessCheck, ReadinessCheck } from \"./model\";\n\nexport class HealthService {\n    private checks: HealthCheck[] \u003d [];\n\n    register(check: HealthCheck): void {\n        this.checks.push(check);\n    }\n\n    runAll(): HealthStatus[] {\n        return this.checks.map(c \u003d\u003e c.check());\n    }\n\n    isHealthy(): boolean {\n        return this.runAll().every(s \u003d\u003e s.status \u003d\u003d\u003d \"UP\");\n    }\n}\n\nconst service \u003d new HealthService();\nservice.register(new LivenessCheck());\n\nconst readiness \u003d new ReadinessCheck();\nreadiness.setReady(true);\nservice.register(readiness);\n\nconst results: HealthStatus[] \u003d service.runAll();\nconsole.log(\"Healthy:\", service.isHealthy());\nconsole.log(\"Results:\", results);\n\nconst broken: number \u003d service.isHealthy();\n"
