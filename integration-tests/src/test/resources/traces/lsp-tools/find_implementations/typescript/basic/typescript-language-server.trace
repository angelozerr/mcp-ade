    "text": "export interface HealthCheck {\n    name: string;\n    check(): HealthStatus;\n}\n\nexport interface HealthStatus {\n    status: \"UP\" | \"DOWN\";\n    message: string;\n    timestamp: number;\n}\n\nexport abstract class AbstractHealthCheck implements HealthCheck {\n    constructor(public name: string) {}\n\n    abstract check(): HealthStatus;\n\n    protected createStatus(status: \"UP\" | \"DOWN\", message: string): HealthStatus {\n        return { status, message, timestamp: Date.now() };\n    }\n}\n\nexport class LivenessCheck extends AbstractHealthCheck {\n    constructor() {\n        super(\"liveness\");\n    }\n\n    check(): HealthStatus {\n        return this.createStatus(\"UP\", \"Service is alive\");\n    }\n}\n\nexport class ReadinessCheck extends AbstractHealthCheck {\n    private ready: boolean \u003d false;\n\n    constructor() {\n        super(\"readiness\");\n    }\n\n    setReady(ready: boolean): void {\n        this.ready \u003d ready;\n    }\n\n    check(): HealthStatus {\n        return this.createStatus(\n            this.ready ? \"UP\" : \"DOWN\",\n            this.ready ? \"Service is ready\" : \"Service is not ready\"\n        );\n    }\n}\n"
  }
}



