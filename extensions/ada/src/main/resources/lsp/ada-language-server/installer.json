{
  "id": "ada-language-server-installer",
  "name": "ada_language_server",
  "check": {
    "fileExists": {
      "name": "Check if Ada Language Server is installed",
      "file": {
        "windows": "$SERVER_HOME$/integration/vscode/ada/x64/win32/ada_language_server.exe",
        "unix": {
          "x86_64": "$SERVER_HOME$/integration/vscode/ada/x64/linux/ada_language_server",
          "arm64": "$SERVER_HOME$/integration/vscode/ada/arm64/linux/ada_language_server"
        },
        "mac": {
          "x86_64": "$SERVER_HOME$/integration/vscode/ada/x64/darwin/ada_language_server",
          "arm64": "$SERVER_HOME$/integration/vscode/ada/arm64/darwin/ada_language_server"
        }
      }
    }
  },
  "run": {
    "download": {
      "name": "Download Ada Language Server",
      "github": {
        "owner": "AdaCore",
        "repository": "ada_language_server",
        "prerelease": false,
        "asset": {
          "windows": "als-*-win32-x64.tar.gz",
          "unix": {
            "x86_64": "als-*-linux-x64.tar.gz",
            "arm64": "als-*-linux-arm64.tar.gz"
          },
          "mac": {
            "x86_64": "als-*-darwin-x64.tar.gz",
            "arm64": "als-*-darwin-arm64.tar.gz"
          }
        }
      },
      "output": {
        "dir": "$SERVER_HOME$",
        "file": {
          "name": {
            "windows": "integration/vscode/ada/x64/win32/ada_language_server.exe",
            "unix": {
              "x86_64": "integration/vscode/ada/x64/linux/ada_language_server",
              "arm64": "integration/vscode/ada/arm64/linux/ada_language_server"
            },
            "mac": {
              "x86_64": "integration/vscode/ada/x64/darwin/ada_language_server",
              "arm64": "integration/vscode/ada/arm64/darwin/ada_language_server"
            }
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Ada Language Server command",
          "command": "${output.dir}/${output.file.name}"
        }
      }
    }
  }
}
