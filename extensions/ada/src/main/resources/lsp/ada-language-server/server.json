{
  "id": "ada-language-server",
  "name": "Ada Language Server",
  "description": "Language server for Ada/SPARK",
  "url": "https://github.com/AdaCore/ada_language_server",
  "documentSelector": [
    {
      "language": "ada"
    }
  ],
  "configuration": {
    "ada.onTypeFormatting.indentOnly": null,
    "ada.rangeFormattingFallback": null,
    "ada.rangeFormatting.formatChoice": null,
    "ada.documentationStyle": null,
    "ada.displayMethodAncestryOnNavigation": null,
    "ada.foldComments": null,
    "ada.namedNotationThreshold": 3,
    "ada.useCompletionSnippets": null,
    "ada.insertWithClauses": null,
    "ada.renameInComments": null,
    "ada.projectDiagnostics": null,
    "ada.alireDiagnostics": null,
    "ada.sourceInfoDiagnostics": null,
    "ada.adaFileDiagnostics": null,
    "ada.semanticDiagnostics": null,
    "ada.gprFileDiagnostics": null,
    "ada.workspaceSearch": "fuzzy",
    "ada.enableIndexing": null,
    "ada.followSymlinks": null
  }
}
