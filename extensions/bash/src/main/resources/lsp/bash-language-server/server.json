{
  "id": "bash-language-server",
  "name": "Bash Language Server",
  "description": "Language server for Bash/Shell scripts",
  "url": "https://github.com/bash-lsp/bash-language-server",
  "runtime": "nodejs",
  "documentSelector": [
    {
      "language": "shellscript"
    }
  ],
  "configuration": {
    "bashIde.backgroundAnalysisMaxFiles": 500,
    "bashIde.enableSourceErrorDiagnostics": false,
    "bashIde.includeAllWorkspaceSymbols": false,
    "bashIde.shellcheckExternalSources": true,
    "bashIde.shellcheckArguments": "",
    "bashIde.shfmt.ignoreEditorconfig": false,
    "bashIde.shfmt.languageDialect": "auto",
    "bashIde.shfmt.binaryNextLine": false,
    "bashIde.shfmt.caseIndent": false,
    "bashIde.shfmt.funcNextLine": false,
    "bashIde.shfmt.keepPadding": false,
    "bashIde.shfmt.simplifyCode": false,
    "bashIde.shfmt.spaceRedirects": false
  }
}
