{
  "id": "bash-language-server-installer",
  "name": "bash-language-server",
  "check": {
    "fileExists": {
      "name": "Check if bash-language-server is installed",
      "file": "${serverDist}/node_modules/.bin/bash-language-server*"
    }
  },
  "run": {
    "exec": {
      "name": "Install bash-language-server",
      "workingDir": "${serverDist}/node_modules",
      "command": {
        "windows": "npm.cmd install bash-language-server --force",
        "default": "npm install bash-language-server --force"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure bash-language-server command",
          "command": {
            "windows": "${serverDist}/node_modules/.bin/bash-language-server.cmd start",
            "default": "${serverDist}/node_modules/.bin/bash-language-server start"
          }
        }
      }
    }
  }
}
