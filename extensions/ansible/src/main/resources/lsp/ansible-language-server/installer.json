{
  "id": "ansible-language-server-installer",
  "name": "ansible-language-server",
  "check": {
    "fileExists": {
      "name": "Check if ansible-language-server is installed",
      "file": "${serverDist}/node_modules/.bin/ansible-language-server*"
    }
  },
  "run": {
    "exec": {
      "name": "Install @ansible/ansible-language-server",
      "workingDir": "${serverDist}/node_modules",
      "command": {
        "windows": "npm.cmd install @ansible/ansible-language-server --force",
        "default": "npm install @ansible/ansible-language-server --force"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure ansible-language-server command",
          "command": {
            "windows": "${serverDist}/node_modules/.bin/ansible-language-server.cmd --stdio",
            "default": "${serverDist}/node_modules/.bin/ansible-language-server --stdio"
          }
        }
      }
    }
  }
}
