{
  "id": "ansible-language-server",
  "name": "Ansible Language Server",
  "description": "Language server for Ansible playbooks and roles",
  "url": "https://github.com/ansible/vscode-ansible",
  "runtime": "nodejs",
  "documentSelector": [
    {
      "language": "ansible"
    }
  ],
  "configuration": {
    "ansible.validation.enabled": true,
    "ansible.validation.lint.enabled": true,
    "ansible.validation.lint.arguments": "",
    "ansible.validation.lint.autoFixOnSave": false,
    "ansible.completion.provideRedirectModules": true,
    "ansible.completion.provideModuleOptionAliases": true,
    "ansible.ansible.useFullyQualifiedCollectionNames": true,
    "ansible.ansible.reuseTerminal": false
  }
}
