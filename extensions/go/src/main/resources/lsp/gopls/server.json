{
  "id": "gopls",
  "name": "Go Language Server",
  "description": "Go language server based on gopls",
  "url": "https://github.com/golang/tools/tree/master/gopls",
  "runtime": "go",
  "initializationOptions": {
    "ui.semanticTokens": true
  },
  "documentSelector": [
    {
      "language": "go"
    },
    {
      "language": "go.mod"
    },
    {
      "language": "go.sum"
    }
  ],
  "configuration": {
    "gopls.build.buildFlags": [],
    "gopls.build.directoryFilters": ["-**/node_modules"],
    "gopls.build.expandWorkspaceToModule": true,
    "gopls.build.standaloneTags": ["ignore"],
    "gopls.build.templateExtensions": [],
    "gopls.formatting.gofumpt": false,
    "gopls.formatting.local": "",
    "gopls.ui.codelenses.generate": true,
    "gopls.ui.codelenses.regenerate_cgo": true,
    "gopls.ui.codelenses.run_govulncheck": true,
    "gopls.ui.codelenses.test": false,
    "gopls.ui.codelenses.tidy": true,
    "gopls.ui.codelenses.upgrade_dependency": true,
    "gopls.ui.codelenses.vendor": true,
    "gopls.ui.codelenses.vulncheck": false,
    "gopls.ui.completion.completeFunctionCalls": true,
    "gopls.ui.completion.completionBudget": "100ms",
    "gopls.ui.completion.experimentalPostfixCompletions": true,
    "gopls.ui.completion.matcher": "Fuzzy",
    "gopls.ui.completion.usePlaceholders": false,
    "gopls.ui.diagnostic.analyses": {},
    "gopls.ui.diagnostic.annotations.bounds": true,
    "gopls.ui.diagnostic.annotations.escape": true,
    "gopls.ui.diagnostic.annotations.inline": true,
    "gopls.ui.diagnostic.annotations.nil": true,
    "gopls.ui.diagnostic.diagnosticsDelay": "1s",
    "gopls.ui.diagnostic.diagnosticsTrigger": "Edit",
    "gopls.ui.diagnostic.vulncheck": "Off",
    "gopls.ui.inlayHint.assignVariableTypes": false,
    "gopls.ui.inlayHint.compositeLiteralFields": false,
    "gopls.ui.inlayHint.compositeLiteralTypes": false,
    "gopls.ui.inlayHint.constantValues": false,
    "gopls.ui.inlayHint.functionTypeParameters": false,
    "gopls.ui.inlayHint.parameterNames": false,
    "gopls.ui.inlayHint.rangeVariableTypes": false,
    "gopls.ui.navigation.importShortcut": "Both",
    "gopls.ui.navigation.symbolMatcher": "FastFuzzy",
    "gopls.ui.navigation.symbolScope": "all",
    "gopls.ui.navigation.symbolStyle": "Dynamic",
    "gopls.ui.semanticTokens": false,
    "gopls.ui.noSemanticNumber": false,
    "gopls.ui.noSemanticString": false
  }
}
