{
  "id": "yaml-language-server",
  "name": "YAML Language Server",
  "description": "YAML language server by Red Hat with JSON Schema validation",
  "url": "https://github.com/redhat-developer/yaml-language-server",
  "runtime": "nodejs",
  "documentSelector": [
    {
      "language": "yaml"
    }
  ],
  "configuration": {
    "yaml.format.enable": true,
    "yaml.format.singleQuote": false,
    "yaml.format.bracketSpacing": true,
    "yaml.format.proseWrap": "preserve",
    "yaml.format.printWidth": 80,
    "yaml.validate": true,
    "yaml.hover": true,
    "yaml.completion": true,
    "yaml.customTags": [],
    "yaml.schemaStore.enable": true,
    "yaml.schemaStore.url": "https://www.schemastore.org/api/json/catalog.json",
    "yaml.disableAdditionalProperties": false,
    "yaml.maxItemsComputed": 5000
  }
}
