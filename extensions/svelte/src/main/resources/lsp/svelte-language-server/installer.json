{
  "id": "svelte-language-server-installer",
  "name": "svelte-language-server",
  "check": {
    "fileExists": {
      "name": "Check if svelte-language-server is installed",
      "file": "${serverHome}/node_modules/.bin/svelteserver*"
    }
  },
  "run": {
    "exec": {
      "name": "Install svelte-language-server",
      "workingDir": "${serverHome}/node_modules",
      "command": {
        "windows": "npm.cmd install svelte-language-server --force",
        "default": "npm install svelte-language-server --force"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure svelte-language-server command",
          "command": {
            "windows": "${serverHome}/node_modules/.bin/svelteserver.cmd --stdio",
            "default": "${serverHome}/node_modules/.bin/svelteserver --stdio"
          }
        }
      }
    }
  }
}
