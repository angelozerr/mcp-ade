{
  "id": "julia",
  "name": "Julia",
  "description": "Julia runtime required by Julia-based language servers",
  "url": "https://julialang.org",
  "check": {
    "exec": {
      "name": "Check if Julia is available",
      "command": {
        "windows": "where julia",
        "default": "which julia"
      },
      "timeout": 5000
    }
  },
  "run": {
    "download": {
      "name": "Download Julia",
      "julia": {},
      "output": {
        "dir": "${serverHome}",
        "stripRootDir": true
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Julia",
          "command": {
            "windows": "${serverHome}/bin/julia.exe",
            "default": "${serverHome}/bin/julia"
          }
        }
      }
    }
  }
}
