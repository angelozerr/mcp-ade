{
  "id": "julia-debug",
  "name": "Julia Debug Adapter",
  "description": "Debug adapter for Julia based on DebugAdapter.jl",
  "url": "https://github.com/julia-vscode/DebugAdapter.jl",
  "runtime": "julia",
  "launch": "julia $SERVER_HOME$/run_server.jl",
  "debugServerReadyPattern": "DAP server listening on port ${port}",
  "attach": {
    "port": "$port"
  },
  "documentSelector": [
    {
      "language": "julia",
      "pattern": "**/*.jl"
    }
  ]
}
