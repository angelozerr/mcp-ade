{
  "id": "julia-debug-installer",
  "name": "julia-debug",
  "check": {
    "fileExists": {
      "name": "Check if run_server.jl exists",
      "file": "${serverHome}/run_server.jl",
      "onSuccess": {
        "fileExists": {
          "name": "Check if DebugAdapter.jl is installed",
          "file": "${userHome}/.julia/packages/DebugAdapter/*"
        }
      }
    }
  },
  "run": {
    "exec": {
      "name": "Install DebugAdapter.jl",
      "command": "julia -e \"using Pkg; Pkg.add(\\\"DebugAdapter\\\")\""
    }
  }
}
