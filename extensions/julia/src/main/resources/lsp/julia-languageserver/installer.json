{
  "id": "julia-languageserver-installer",
  "name": "julia-languageserver",
  "check": {
    "fileExists": {
      "name": "Check if LanguageServer.jl is installed",
      "file": "$USER_HOME$/.julia/packages/LanguageServer/*"
    }
  },
  "run": {
    "exec": {
      "name": "Install Julia LanguageServer",
      "command": "julia -e \"using Pkg; Pkg.add(\\\"LanguageServer\\\")\""
    }
  }
}
