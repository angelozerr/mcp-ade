{
  "id": "java-ls",
  "name": "Java LS",
  "description": "Lightweight Java language server with Turbine-based indexer and ECJ compiler",
  "url": "https://github.com/tsmaeder/java-ls",
  "command": "\"C:/Program Files/Eclipse Adoptium/jdk-25.0.4.101-hotspot/bin/java\" --add-exports jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED -jar ${extensionHome}/lsp/java-ls/java-ls.jar",
  "readyNotification": {
    "java/serverStatus": {
      "status": "ready"
    }
  },
  "documentSelector": [
    {
      "language": "java"
    }
  ],
  "fileWatchers": [
    { "globPattern": "**/*.java" },
    { "globPattern": "**/pom.xml" },
    { "globPattern": "**/build.gradle" },
    { "globPattern": "**/build.gradle.kts" }
  ]
}
