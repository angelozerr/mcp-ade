{
  "id": "jakarta",
  "name": "Jakarta EE Language Server",
  "check": {
    "fileExists": {
      "name": "Check if Jakarta EE LS is installed",
      "file": "${serverHome}/lib/org.eclipse.lsp4jakarta.ls-uber.jar"
    }
  },
  "run": {
    "copy": {
      "name": "Copy Jakarta EE LS JAR",
      "source": "/lsp/jakarta/lib/org.eclipse.lsp4jakarta.ls-uber.jar",
      "destination": "${serverHome}/lib/org.eclipse.lsp4jakarta.ls-uber.jar",
      "onSuccess": {
        "configureServer": {
          "name": "Configure Jakarta EE LS command",
          "command": "java -jar ${serverHome}/lib/org.eclipse.lsp4jakarta.ls-uber.jar",
          "update": true
        }
      }
    }
  }
}
