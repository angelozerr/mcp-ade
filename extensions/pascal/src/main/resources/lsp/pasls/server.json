{
  "id": "pasls",
  "name": "Pascal Language Server",
  "description": "Language server for Pascal and Object Pascal",
  "runtime": "fpc",
  "url": "https://github.com/genericptr/pascal-language-server",
  "documentSelector": [
    {
      "language": "pascal"
    },
    {
      "language": "objectpascal"
    }
  ],
  "configuration": {
    "pascalLanguageServer.initializationOptions.overloadPolicy": 3,
    "pascalLanguageServer.initializationOptions.maximumCompletions": 100,
    "pascalLanguageServer.initializationOptions.insertCompletionsAsSnippets": true,
    "pascalLanguageServer.initializationOptions.insertCompletionProcedureBrackets": false,
    "pascalLanguageServer.initializationOptions.includeWorkspaceFoldersAsUnitPaths": true,
    "pascalLanguageServer.initializationOptions.includeWorkspaceFoldersAsIncludePaths": true,
    "pascalLanguageServer.initializationOptions.checkSyntax": false,
    "pascalLanguageServer.initializationOptions.checkInactiveRegions": true,
    "pascalLanguageServer.initializationOptions.publishDiagnostics": false,
    "pascalLanguageServer.initializationOptions.workspaceSymbols": false,
    "pascalLanguageServer.initializationOptions.documentSymbols": true,
    "pascalLanguageServer.initializationOptions.minimalisticCompletions": false,
    "pascalLanguageServer.initializationOptions.showSyntaxErrors": true
  }
}
