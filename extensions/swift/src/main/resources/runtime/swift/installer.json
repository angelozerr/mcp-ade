{
  "id": "swift",
  "name": "Swift",
  "description": "Swift toolchain required by Swift-based language servers",
  "url": "https://swift.org",
  "check": {
    "exec": {
      "name": "Check if Swift is available",
      "command": {
        "windows": "where swift",
        "default": "which swift"
      },
      "timeout": 5000
    }
  }
}
