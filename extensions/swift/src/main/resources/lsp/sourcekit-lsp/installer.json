{
  "id": "sourcekit-lsp-installer",
  "name": "sourcekit-lsp",
  "check": {
    "exec": {
      "name": "Check if sourcekit-lsp is available",
      "command": "sourcekit-lsp --help",
      "timeout": 5000
    }
  },
  "run": {
    "configureServer": {
      "name": "Configure SourceKit-LSP command",
      "command": "sourcekit-lsp"
    }
  }
}
