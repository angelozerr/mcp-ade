{
  "id": "sourcekit-lsp",
  "name": "SourceKit-LSP (Swift Language Server)",
  "description": "Language server for Swift, included with the Swift toolchain",
  "url": "https://github.com/swiftlang/sourcekit-lsp",
  "runtime": "swift",
  "documentSelector": [
    {
      "language": "swift"
    }
  ],
  "configuration": {
    "swift.diagnosticsCollection": "keepSourceKit",
    "swift.diagnosticsStyle": "default",
    "swift.backgroundCompilation": false,
    "swift.showTestCodeLenses": true,
    "swift.sourcekit-lsp.backgroundIndexing": "auto",
    "swift.sourcekit-lsp.supported-languages": ["swift", "objective-c", "objective-cpp", "c", "cpp"]
  }
}
