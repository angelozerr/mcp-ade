{
  "id": "jdtls",
  "name": "Eclipse JDT Language Server",
  "check": {
    "fileExists": {
      "name": "Check if JDT.LS is installed",
      "file": "${serverHome}/bin/jdtls"
    }
  },
  "run": {
    "download": {
      "name": "Download JDT.LS",
      "url": "https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz",
      "output": {
        "dir": "${serverHome}",
        "file": {
          "name": {
            "windows": "bin/jdtls.bat",
            "default": "bin/jdtls"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure JDT.LS server command",
          "command": "\"${serverHome}/${output.file.name}\" -configuration \"${mcpHome}/.cache/jdtls\" -data \"${workspaceFolder}/jdtls-data\""
        }
      }
    }
  }
}
