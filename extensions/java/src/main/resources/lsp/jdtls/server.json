{
  "id": "jdtls",
  "name": "Eclipse JDT Language Server",
  "description": "Java language server based on Eclipse JDT",
  "url": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
  "runtime": "jdk",
  "readyNotification": {
    "language/status": {
      "type": "ServiceReady"
    }
  },
  "statusNotification": {
    "language/status": "message"
  },
  "toolsRequest": {
    "skipDidOpen": true
  },
  "documentSelector": [
    {
      "language": "java"
    }
  ],
  "fileWatchers": [
    { "globPattern": "**/*.java" },
    { "globPattern": "**/pom.xml" },
    { "globPattern": "**/.classpath" },
    { "globPattern": "**/.project" },
    { "globPattern": "**/.settings/*.prefs" },
    { "globPattern": "**/build.gradle" },
    { "globPattern": "**/build.gradle.kts" }
  ],
  "applicableSettings": ["java.*"],
  "settings": {
    "properties": {
      "maven.buildSupport": {
        "type": "string",
        "title": "Maven build support",
        "description": "How Maven projects are handled. Native: M2E import (full IDE support). Fast: direct classpath extraction with cache (faster startup).",
        "enum": ["native", "fast"],
        "enumDescriptions": ["Native (M2E import)", "Fast (direct classpath extraction with cache)"],
        "default": "native"
      },
      "gradle.buildSupport": {
        "type": "string",
        "title": "Gradle build support",
        "description": "How Gradle projects are handled. Native: Buildship import (full IDE support). Fast: direct classpath extraction with cache (faster startup). BSP: Build Server Protocol via build-server-for-gradle.",
        "enum": ["native", "fast", "bsp"],
        "enumDescriptions": ["Native (Buildship import)", "Fast (direct classpath extraction with cache)", "BSP (Build Server Protocol)"],
        "default": "native"
      }
    }
  },
  "configuration": {
    "java.format.enabled": true,
    "java.format.comments.enabled": true,
    "java.format.onType.enabled": true,
    "java.completion.enabled": true,
    "java.completion.postfix.enabled": true,
    "java.completion.chain.enabled": false,
    "java.completion.favoriteStaticMembers": [
      "org.junit.Assert.*",
      "org.junit.Assume.*",
      "org.junit.jupiter.api.Assertions.*",
      "org.junit.jupiter.api.Assumptions.*",
      "org.junit.jupiter.api.DynamicContainer.*",
      "org.junit.jupiter.api.DynamicTest.*",
      "org.mockito.Mockito.*",
      "org.mockito.ArgumentMatchers.*",
      "org.mockito.Answers.*"
    ],
    "java.completion.filteredTypes": [
      "java.awt.*",
      "com.sun.*",
      "sun.*",
      "jdk.*",
      "org.graalvm.*",
      "io.micrometer.shaded.*"
    ],
    "java.completion.guessMethodArguments": "auto",
    "java.completion.matchCase": "firstLetter",
    "java.completion.importOrder": ["#", "java", "javax", "org", "com", ""],
    "java.completion.lazyResolveTextEdit.enabled": true,
    "java.completion.maxResults": 0,
    "java.completion.collapseCompletionItems": false,
    "java.signatureHelp.enabled": true,
    "java.signatureHelp.description.enabled": false,
    "java.codeGeneration.insertionLocation": "afterCursor",
    "java.codeGeneration.addFinalForNewDeclaration": "none",
    "java.codeGeneration.hashCodeEquals.useJava7Objects": false,
    "java.codeGeneration.hashCodeEquals.useInstanceof": false,
    "java.codeGeneration.useBlocks": false,
    "java.codeGeneration.generateComments": false,
    "java.codeGeneration.toString.template": "${object.className} [${member.name()}=${member.value}, ${otherMembers}]",
    "java.codeGeneration.toString.codeStyle": "STRING_CONCATENATION",
    "java.codeGeneration.toString.skipNullValues": false,
    "java.codeGeneration.toString.listArrayContents": true,
    "java.codeGeneration.toString.limitElements": 0,
    "java.autobuild.enabled": true,
    "java.maxConcurrentBuilds": 1,
    "java.implementationCodeLens": "none",
    "java.referencesCodeLens.enabled": false,
    "java.referencesCodeLens.includeFields": false,
    "java.inlayHints.parameterNames.enabled": "literals",
    "java.inlayHints.parameterNames.exclusions": [],
    "java.inlayHints.variableTypes.enabled": false,
    "java.inlayHints.parameterTypes.enabled": false,
    "java.inlayHints.formatParameters.enabled": false,
    "java.import.gradle.enabled": true,
    "java.import.gradle.wrapper.enabled": true,
    "java.import.gradle.offline.enabled": false,
    "java.import.gradle.annotationProcessing.enabled": true,
    "java.import.maven.enabled": true,
    "java.import.maven.offline.enabled": false,
    "java.import.maven.disableTestClasspathFlag": false,
    "java.import.exclusions": ["**/node_modules/**", "**/.metadata/**", "**/archetype-resources/**", "**/META-INF/maven/**"],
    "java.maven.downloadSources": false,
    "java.maven.updateSnapshots": false,
    "java.saveActions.organizeImports": false,
    "java.saveActions.cleanup": true,
    "java.updateImportsOnPaste.enabled": true,
    "java.sources.organizeImports.starThreshold": 99,
    "java.sources.organizeImports.staticStarThreshold": 99,
    "java.edit.validateAllOpenBuffersOnChanges": false,
    "java.edit.smartSemicolonDetection.enabled": false,
    "java.selectionRange.enabled": true,
    "java.cleanup.actions": ["renameFileToType"],
    "java.compile.nullAnalysis.nonnull": ["javax.annotation.Nonnull", "org.eclipse.jdt.annotation.NonNull", "org.springframework.lang.NonNull", "org.jspecify.annotations.NonNull"],
    "java.compile.nullAnalysis.nullable": ["javax.annotation.Nullable", "org.eclipse.jdt.annotation.Nullable", "org.springframework.lang.Nullable", "org.jspecify.annotations.Nullable"],
    "java.compile.nullAnalysis.nonnullbydefault": ["javax.annotation.ParametersAreNonnullByDefault", "org.eclipse.jdt.annotation.NonNullByDefault", "org.springframework.lang.NonNullApi", "org.jspecify.annotations.NullMarked"],
    "java.compile.nullAnalysis.mode": "interactive",
    "java.quickfix.showAt": "line",
    "java.refactoring.extract.interface.replace": true,
    "java.errors.incompleteClasspath.severity": "warning",
    "java.symbols.includeSourceMethodDeclarations": false,
    "java.foldingRange.enabled": true,
    "java.codeAction.sortMembers.avoidVolatileChanges": true,
    "java.references.includeAccessors": true,
    "java.references.includeDeclarations": true,
    "java.references.includeDecompiledSources": true,
    "java.hover.javadoc.enabled": true,
    "java.typeHierarchy.lazyLoad": false,
    "java.search.scope": "all",
    "java.eclipse.downloadSources": false,
    "java.diagnostic.filter": []
  }
}
