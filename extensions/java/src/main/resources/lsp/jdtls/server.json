{
  "id": "jdtls",
  "name": "Eclipse JDT Language Server",
  "description": "Java language server based on Eclipse JDT",
  "url": "https://github.com/eclipse-jdtls/eclipse.jdt.ls",
  "runtime": "jdk",
  "readyNotification": {
    "language/status": {
      "type": "ServiceReady"
    }
  },
  "statusNotification": {
    "language/status": "message"
  },
  "toolsRequest": {
    "skipDidOpen": true
  },
  "documentSelector": [
    {
      "language": "java"
    }
  ],
  "fileWatchers": [
    { "globPattern": "**/*.java" },
    { "globPattern": "**/pom.xml" },
    { "globPattern": "**/.classpath" },
    { "globPattern": "**/.project" },
    { "globPattern": "**/.settings/*.prefs" },
    { "globPattern": "**/build.gradle" },
    { "globPattern": "**/build.gradle.kts" }
  ],
  "applicableSettings": ["java.*"],
  "settings": [
    {
      "key": "maven.buildSupport",
      "label": "Maven build support",
      "description": "How Maven projects are handled. Native: M2E import (full IDE support). Fast: direct classpath extraction with cache (faster startup).",
      "type": "enum",
      "values": ["native", "fast"],
      "valueLabels": {
        "native": "Native (M2E import)",
        "fast": "Fast (direct classpath extraction with cache)"
      },
      "default": "native"
    },
    {
      "key": "gradle.buildSupport",
      "label": "Gradle build support",
      "description": "How Gradle projects are handled. Native: Buildship import (full IDE support). Fast: direct classpath extraction with cache (faster startup). BSP: Build Server Protocol via build-server-for-gradle.",
      "type": "enum",
      "values": ["native", "fast", "bsp"],
      "valueLabels": {
        "native": "Native (Buildship import)",
        "fast": "Fast (direct classpath extraction with cache)",
        "bsp": "BSP (Build Server Protocol)"
      },
      "default": "native"
    }
  ]
}
