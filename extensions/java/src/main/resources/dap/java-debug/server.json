{
	"id": "java-debug",
	"name": "Java Debug Server",
	"description": "Java Debug Server for Visual Studio Code",
	"url": "https://github.com/microsoft/java-debug",
	"launchMethod": "vscode.java.startDebugSession",
	"documentSelector": [
		{
			"language": "java"
		}
	],
	"resolve": {
		"launch": [
			{
				"vscode.java.validateLaunchConfig": {
					"args": ["${workspaceUri}", "${mainClass}", "${projectName}", false]
				}
			},
			{
				"vscode.java.buildWorkspace": {
					"args": ["{\"isFullBuild\":false}"]
				}
			},
			{
				"vscode.java.resolveClasspath": {
					"args": ["${mainClass}", "${projectName}", null],
					"returns": {
						"modulePaths": "$[0]",
						"classPaths": "$[1]"
					}
				}
			},
			{
				"vscode.java.resolveJavaExecutable": {
					"args": ["${mainClass}", "${projectName}"],
					"returns": {
						"javaExec": "$"
					}
				}
			}
		]
	},
	"contributes": {
		"jdtls": {
			"bundles": [
				"extension/server/*.jar"
			],
			"bindRequest": [
				"vscode.java.validateLaunchConfig",
				"vscode.java.buildWorkspace",
				"vscode.java.resolveClasspath",
				"vscode.java.resolveJavaExecutable",
				"vscode.java.startDebugSession"
			]
		}
	}
}