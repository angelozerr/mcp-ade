{
  "id": "texlab-installer",
  "name": "texlab",
  "check": {
    "fileExists": {
      "name": "Check if texlab is installed",
      "file": {
        "windows": "${serverDist}/texlab.exe",
        "default": "${serverDist}/texlab"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download texlab",
      "github": {
        "owner": "latex-lsp",
        "repository": "texlab",
        "prerelease": false,
        "asset": {
          "windows": {
            "x86_64": "texlab-x86_64-windows.zip",
            "arm64": "texlab-aarch64-windows.zip"
          },
          "unix": {
            "x86_64": "texlab-x86_64-linux.tar.gz",
            "arm64": "texlab-aarch64-linux.tar.gz"
          },
          "mac": {
            "x86_64": "texlab-x86_64-macos.tar.gz",
            "arm64": "texlab-aarch64-macos.tar.gz"
          }
        }
      },
      "output": {
        "file": {
          "name": {
            "windows": "texlab.exe",
            "default": "texlab"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure texlab command",
          "command": {
            "windows": "${serverDist}/texlab.exe",
            "default": "${serverDist}/texlab"
          }
        }
      }
    }
  }
}
