{
  "id": "qute",
  "name": "Qute Language Server",
  "description": "Qute template engine support",
  "url": "https://github.com/redhat-developer/quarkus-ls",
  "runtime": "jdk",
  "documentSelector": [
    {
      "language": "qute-html"
    },
    {
      "language": "qute-json"
    },
    {
      "language": "qute-yaml"
    },
    {
      "language": "qute-txt"
    }
  ],
  "configuration": {
    "qute.codeLens.enabled": true,
    "qute.inlayHint.enabled": true,
    "qute.inlayHint.showSectionParameterType": true,
    "qute.inlayHint.showSectionParameterDefaultValue": true,
    "qute.inlayHint.showMessages": true,
    "qute.native.enabled": false,
    "qute.validation.enabled": false,
    "qute.validation.undefinedObject.severity": "warning",
    "qute.validation.undefinedNamespace.severity": "warning",
    "qute.validation.undefinedSectionTag.severity": "warning",
    "qute.format.splitSectionParameters": "preserve",
    "qute.format.splitSectionParametersIndentSize": 2
  },
  "contributes": {
    "jdtls": {
      "bundles": ["plugins/*.jar"],
      "bindRequest": [
        "qute/template/projects",
        "qute/template/project",
        "qute/template/projectDataModel",
        "qute/template/binaryTemplates",
        "qute/template/javaTypes",
        "qute/template/resolvedJavaType",
        "qute/template/javaDefinition",
        "qute/template/javadoc",
        "qute/template/generateMissingJavaMember",
        "qute/java/codeLens",
        "qute/java/diagnostics",
        "qute/java/documentLink"
      ],
      "bindNotification": [
        "qute/dataModelChanged"
      ]
    }
  }
}
