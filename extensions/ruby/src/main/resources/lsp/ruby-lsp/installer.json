{
  "id": "ruby-lsp-installer",
  "name": "ruby-lsp",
  "check": {
    "exec": {
      "name": "Check if Ruby LSP is available",
      "command": {
        "windows": "where ruby-lsp",
        "default": "which ruby-lsp"
      },
      "timeout": 5000
    }
  },
  "run": {
    "exec": {
      "name": "Install Ruby LSP",
      "command": {
        "windows": "gem uninstall prism --all --force --executables 2>NUL & gem install ruby-lsp --no-document",
        "default": "gem install ruby-lsp --no-document"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Ruby LSP command",
          "command": "ruby-lsp"
        }
      }
    }
  }
}
