{
  "id": "dotnet",
  "name": ".NET SDK",
  "description": ".NET SDK required by .NET-based language servers",
  "url": "https://dotnet.microsoft.com",
  "env": {
    "DOTNET_ROOT": "${serverDist}",
    "DOTNET_MULTILEVEL_LOOKUP": "0"
  },
  "check": {
    "exec": {
      "name": "Check if .NET is available",
      "command": {
        "windows": "where dotnet",
        "default": "which dotnet"
      },
      "timeout": 5000
    }
  },
  "run": {
    "download": {
      "name": "Download .NET SDK",
      "dotnet": {
        "release-type": "lts",
        "component": "sdk"
      },
      "output": {
        "stripRootDir": false
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure .NET SDK",
          "command": {
            "windows": "${serverDist}/dotnet.exe",
            "default": "${serverDist}/dotnet"
          }
        }
      }
    }
  }
}
