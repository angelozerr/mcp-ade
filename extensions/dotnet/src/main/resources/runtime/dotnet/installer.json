{
  "id": "dotnet",
  "name": ".NET SDK",
  "description": ".NET SDK required by .NET-based language servers",
  "url": "https://dotnet.microsoft.com",
  "env": {
    "DOTNET_ROOT": "${serverHome}"
  },
  "check": {
    "exec": {
      "name": "Check if .NET is available",
      "command": "dotnet --version",
      "timeout": 5000
    }
  },
  "run": {
    "download": {
      "name": "Download .NET SDK",
      "dotnet": {
        "release-type": "lts",
        "component": "sdk"
      },
      "output": {
        "dir": "${serverHome}",
        "stripRootDir": false
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure .NET SDK",
          "command": {
            "windows": "${serverHome}/dotnet.exe",
            "default": "${serverHome}/dotnet"
          }
        }
      }
    }
  }
}
