{
  "id": "fsautocomplete-installer",
  "name": "fsautocomplete",
  "runtime": "dotnet",
  "check": {
    "fileExists": {
      "name": "Check if fsautocomplete is installed",
      "file": {
        "windows": "${serverHome}/fsautocomplete.cmd",
        "default": "${serverHome}/fsautocomplete"
      }
    }
  },
  "run": {
    "exec": {
      "name": "Install FsAutoComplete",
      "command": "dotnet tool install fsautocomplete --tool-path ${serverHome}",
      "onSuccess": {
        "configureServer": {
          "name": "Configure fsautocomplete command",
          "command": {
            "windows": "${serverHome}/fsautocomplete.cmd --adaptive-lsp-server-enabled",
            "default": "${serverHome}/fsautocomplete --adaptive-lsp-server-enabled"
          }
        }
      }
    }
  }
}
