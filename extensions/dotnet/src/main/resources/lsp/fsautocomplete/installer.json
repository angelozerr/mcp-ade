{
  "id": "fsautocomplete-installer",
  "name": "fsautocomplete",
  "runtime": "dotnet",
  "check": {
    "fileExists": {
      "name": "Check if fsautocomplete is installed",
      "file": {
        "windows": "$SERVER_HOME$/fsautocomplete.cmd",
        "default": "$SERVER_HOME$/fsautocomplete"
      }
    }
  },
  "run": {
    "exec": {
      "name": "Install FsAutoComplete",
      "command": "dotnet tool install fsautocomplete --tool-path $SERVER_HOME$",
      "onSuccess": {
        "configureServer": {
          "name": "Configure fsautocomplete command",
          "command": {
            "windows": "$SERVER_HOME$/fsautocomplete.cmd --adaptive-lsp-server-enabled",
            "default": "$SERVER_HOME$/fsautocomplete --adaptive-lsp-server-enabled"
          }
        }
      }
    }
  }
}
