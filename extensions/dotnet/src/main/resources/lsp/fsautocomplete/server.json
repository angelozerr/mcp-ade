{
  "id": "fsautocomplete",
  "name": "FsAutoComplete (F# Language Server)",
  "description": "F# language server based on FsAutoComplete",
  "url": "https://github.com/fsharp/FsAutoComplete",
  "runtime": "dotnet",
  "documentSelector": [
    {
      "language": "fsharp"
    }
  ],
  "configuration": {
    "FSharp.abstractClassStubGeneration": true,
    "FSharp.abstractClassStubGenerationMethodBody": "failwith \"Not Implemented\"",
    "FSharp.abstractClassStubGenerationObjectIdentifier": "this",
    "FSharp.codeLenses.references.enabled": true,
    "FSharp.codeLenses.signature.enabled": true,
    "FSharp.enableAdaptiveLspServer": true,
    "FSharp.enableAnalyzers": false,
    "FSharp.enableMSBuildProjectGraph": false,
    "FSharp.enableReferenceCodeLens": true,
    "FSharp.externalAutocomplete": false,
    "FSharp.fullNameExternalAutocomplete": false,
    "FSharp.fcs.transparentCompiler.enabled": false,
    "FSharp.fsac.cachedTypeCheckCount": 200,
    "FSharp.fsac.conserveMemory": false,
    "FSharp.fsac.parallelReferenceResolution": false,
    "FSharp.indentationSize": 4,
    "FSharp.inlayHints.disableLongTooltip": false,
    "FSharp.inlayHints.enabled": true,
    "FSharp.inlayHints.parameterNames": true,
    "FSharp.inlayHints.typeAnnotations": true,
    "FSharp.inlineValues.enabled": false,
    "FSharp.inlineValues.prefix": "  // ",
    "FSharp.interfaceStubGeneration": true,
    "FSharp.interfaceStubGenerationMethodBody": "failwith \"Not Implemented\"",
    "FSharp.interfaceStubGenerationObjectIdentifier": "this",
    "FSharp.keywordsAutocomplete": true,
    "FSharp.lineLens.enabled": "replaceCodeLens",
    "FSharp.lineLens.prefix": "  // ",
    "FSharp.linter": true,
    "FSharp.pipelineHints.enabled": true,
    "FSharp.pipelineHints.prefix": "  // ",
    "FSharp.recordStubGeneration": true,
    "FSharp.recordStubGenerationBody": "failwith \"Not Implemented\"",
    "FSharp.resolveNamespaces": true,
    "FSharp.simplifyNameAnalyzer": true,
    "FSharp.unnecessaryParenthesesAnalyzer": true,
    "FSharp.smartIndent": false,
    "FSharp.unionCaseStubGeneration": true,
    "FSharp.unionCaseStubGenerationBody": "failwith \"Not Implemented\"",
    "FSharp.unusedDeclarationsAnalyzer": true,
    "FSharp.addPrivateAccessModifier": false,
    "FSharp.unusedOpensAnalyzer": true,
    "FSharp.workspaceModePeekDeepLevel": 4
  }
}
