{
  "id": "intellij-server",
  "name": "IntelliJ Language Server",
  "description": "JetBrains IntelliJ Language Server",
  "readyNotification": "intellij/ready-for-test",
  "statusNotification": {
    "intellij/importLog": "message"
  },
  "documentSelector": [
    {
      "language": "java"
    },
    {
      "language": "kotlin"
    }
  ],
  "settings": {
    "properties": {
      "eula": {
        "type": "string",
        "title": "EULA acceptance code",
        "description": "JetBrains IntelliJ Language Server EULA acceptance hash. Required to start the server.",
        "default": ""
      }
    },
    "required": ["eula"]
  },
  "command": {
    "windows": "${serverDist}/bin/intellij-server.exe --stdio --system-path \"${workspaceStorageDir}\" --eula ${setting:eula}",
    "default": "${serverDist}/bin/intellij-server --stdio --system-path \"${workspaceStorageDir}\" --eula ${setting:eula}"
  }
}
