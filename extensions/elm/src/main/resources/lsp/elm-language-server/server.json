{
  "id": "elm-language-server",
  "name": "Elm Language Server",
  "description": "Language server for Elm",
  "url": "https://github.com/elm-tooling/elm-language-server",
  "runtime": "nodejs",
  "documentSelector": [
    {
      "language": "elm"
    }
  ],
  "configuration": {
    "elmLS.elmReviewDiagnostics": "off",
    "elmLS.disableElmLSDiagnostics": false,
    "elmLS.skipInstallPackageConfirmation": false,
    "elmLS.onlyUpdateDiagnosticsOnSave": false
  }
}
