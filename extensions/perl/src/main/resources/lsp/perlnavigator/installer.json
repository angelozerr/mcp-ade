{
  "id": "perlnavigator-installer",
  "name": "perlnavigator",
  "check": {
    "fileExists": {
      "name": "Check if PerlNavigator is installed",
      "file": {
        "windows": "${serverHome}/perlnavigator.exe",
        "default": "${serverHome}/perlnavigator"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download PerlNavigator",
      "github": {
        "owner": "bscan",
        "repository": "PerlNavigator",
        "prerelease": false,
        "asset": {
          "windows": {
            "x86_64": "perlnavigator-win-x86_64.zip"
          },
          "unix": {
            "x86_64": "perlnavigator-linux-x86_64.zip"
          },
          "mac": {
            "x86_64": "perlnavigator-macos-x86_64.zip"
          }
        }
      },
      "output": {
        "dir": "${serverHome}",
        "file": {
          "name": {
            "windows": "perlnavigator.exe",
            "default": "perlnavigator"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure PerlNavigator command",
          "command": {
            "windows": "${serverHome}/perlnavigator.exe --stdio",
            "default": "${serverHome}/perlnavigator --stdio"
          }
        }
      }
    }
  }
}
