{
  "id": "angular-language-server",
  "name": "Angular Language Server",
  "check": {
    "fileExists": {
      "name": "Check if Angular Language Server is installed",
      "file": "$SERVER_HOME$/node_modules/.bin/ngserver*"
    }
  },
  "run": {
    "exec": {
      "name": "Install Angular Language Server",
      "workingDir": "$SERVER_HOME$/node_modules",
      "command": {
        "windows": "npm.cmd install @angular/language-server @angular/language-service typescript@5 --force",
        "default": "npm install @angular/language-server @angular/language-service typescript@5 --force"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Angular Language Server command",
          "command": {
            "windows": "$SERVER_HOME$/node_modules/.bin/ngserver.cmd --stdio --tsProbeLocations $SERVER_HOME$/node_modules/node_modules --ngProbeLocations $SERVER_HOME$/node_modules/node_modules",
            "default": "$SERVER_HOME$/node_modules/.bin/ngserver --stdio --tsProbeLocations $SERVER_HOME$/node_modules/node_modules --ngProbeLocations $SERVER_HOME$/node_modules/node_modules"
          }
        }
      }
    }
  }
}
