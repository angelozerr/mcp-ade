{
  "id": "elixir-ls",
  "name": "ElixirLS (Elixir Language Server)",
  "description": "Language server for Elixir",
  "url": "https://github.com/elixir-lsp/elixir-ls",
  "documentSelector": [
    {
      "language": "elixir"
    }
  ],
  "configuration": {
    "elixirLS.autoBuild": true,
    "elixirLS.dialyzerEnabled": true,
    "elixirLS.dialyzerFormat": "dialyxir_long",
    "elixirLS.mixEnv": "test",
    "elixirLS.fetchDeps": false,
    "elixirLS.suggestSpecs": true,
    "elixirLS.autoInsertRequiredAlias": true,
    "elixirLS.signatureAfterComplete": true,
    "elixirLS.enableTestLenses": false
  }
}
