{
  "id": "elixir-ls-installer",
  "name": "elixir-ls",
  "check": {
    "fileExists": {
      "name": "Check if ElixirLS is installed",
      "file": {
        "windows": "${serverHome}/language_server.bat",
        "default": "${serverHome}/language_server.sh"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download ElixirLS",
      "github": {
        "owner": "elixir-lsp",
        "repository": "elixir-ls",
        "prerelease": false,
        "asset": {
          "windows": {
            "x86_64": "elixir-ls-*.zip"
          },
          "unix": {
            "x86_64": "elixir-ls-*.zip",
            "arm64": "elixir-ls-*.zip"
          },
          "mac": {
            "x86_64": "elixir-ls-*.zip",
            "arm64": "elixir-ls-*.zip"
          }
        }
      },
      "output": {
        "dir": "${serverHome}",
        "file": {
          "name": {
            "windows": "language_server.bat",
            "default": "language_server.sh"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure ElixirLS command",
          "command": {
            "windows": "${serverHome}/language_server.bat",
            "default": "${serverHome}/language_server.sh"
          }
        }
      }
    }
  }
}
