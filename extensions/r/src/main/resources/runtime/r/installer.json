{
  "id": "r",
  "name": "R",
  "description": "R runtime required by R-based language servers",
  "url": "https://www.r-project.org",
  "check": {
    "exec": {
      "name": "Check if R is available",
      "command": {
        "windows": "where Rscript",
        "default": "which Rscript"
      },
      "timeout": 5000
    }
  }
}
