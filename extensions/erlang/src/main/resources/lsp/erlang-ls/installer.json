{
  "id": "erlang-ls-installer",
  "name": "elp",
  "check": {
    "fileExists": {
      "name": "Check if ELP is installed",
      "file": {
        "windows": "${serverDist}/elp.exe",
        "default": "${serverDist}/elp"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download ELP",
      "github": {
        "owner": "WhatsApp",
        "repository": "erlang-language-platform",
        "prerelease": false,
        "asset": {
          "windows": "elp-windows-x86_64-pc-windows-msvc-otp-29*.tar.gz",
          "unix": {
            "x86_64": "elp-linux-x86_64-unknown-linux-gnu-otp-29*.tar.gz",
            "arm64": "elp-linux-aarch64-unknown-linux-gnu-otp-29*.tar.gz"
          },
          "mac": {
            "x86_64": "elp-macos-x86_64-apple-darwin-otp-29*.tar.gz",
            "arm64": "elp-macos-aarch64-apple-darwin-otp-29*.tar.gz"
          }
        }
      },
      "output": {
        "file": {
          "name": {
            "windows": "elp.exe",
            "default": "elp"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure ELP server command",
          "command": "${serverDist}/${dist.file} server"
        }
      }
    }
  }
}
