{
  "id": "dart",
  "name": "Dart SDK",
  "description": "Dart SDK required by Dart-based language servers",
  "url": "https://dart.dev",
  "check": {
    "exec": {
      "name": "Check if Dart is available",
      "command": {
        "windows": "where dart",
        "default": "which dart"
      },
      "timeout": 5000
    }
  },
  "run": {
    "download": {
      "name": "Download Dart SDK",
      "dart": {},
      "output": {
        "stripRootDir": true
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Dart SDK",
          "command": {
            "windows": "${serverDist}/bin/dart.exe",
            "default": "${serverDist}/bin/dart"
          }
        }
      }
    }
  }
}
