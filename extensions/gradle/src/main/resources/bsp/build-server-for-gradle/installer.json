{
  "check": {
    "fileExists": {
      "name": "Check if Gradle BSP server is installed",
      "file": "${serverDist}/extension/lib/server.jar"
    }
  },
  "run": {
    "download": {
      "name": "Download vscode-gradle",
      "openvsx": {
        "namespace": "vscjava",
        "extensionName": "vscode-gradle"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Gradle BSP server command",
          "command": "java -Dplugin.dir=\"${serverDist}/extension/server/plugins\" -cp \"${serverDist}/extension/lib/*\" com.microsoft.java.bs.core.Launcher",
          "update": true
        }
      }
    }
  }
}
