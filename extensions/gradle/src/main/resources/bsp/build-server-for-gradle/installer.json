{
  "check": {
    "fileExists": {
      "name": "Check if Gradle BSP server is installed",
      "file": "$SERVER_HOME$/extension/lib/server.jar"
    }
  },
  "run": {
    "download": {
      "name": "Download vscode-gradle",
      "openvsx": {
        "namespace": "vscjava",
        "extensionName": "vscode-gradle"
      },
      "output": {
        "dir": "$SERVER_HOME$"
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Gradle BSP server command",
          "command": "java -Dplugin.dir=\"$SERVER_HOME$/extension/server/plugins\" -cp \"$SERVER_HOME$/extension/lib/*\" com.microsoft.java.bs.core.Launcher",
          "update": true
        }
      }
    }
  }
}
