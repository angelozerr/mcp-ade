{
  "id": "taplo-installer",
  "name": "taplo",
  "check": {
    "fileExists": {
      "name": "Check if taplo is installed",
      "file": {
        "windows": "${serverDist}/taplo.exe",
        "default": "${serverDist}/taplo"
      }
    }
  },
  "run": {
    "download": {
      "name": "Download taplo",
      "github": {
        "owner": "tamasfe",
        "repository": "taplo",
        "prerelease": false,
        "asset": {
          "windows": {
            "x86_64": "taplo-windows-x86_64.zip",
            "x86": "taplo-windows-x86.zip",
            "arm64": "taplo-windows-aarch64.zip"
          },
          "unix": {
            "x86_64": "taplo-linux-x86_64.gz",
            "arm64": "taplo-linux-aarch64.gz"
          },
          "mac": {
            "x86_64": "taplo-darwin-x86_64.gz",
            "arm64": "taplo-darwin-aarch64.gz"
          }
        }
      },
      "output": {
        "file": {
          "name": {
            "windows": "taplo.exe",
            "default": "taplo"
          },
          "executable": true
        }
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure taplo command",
          "command": {
            "windows": "${serverDist}/taplo.exe lsp stdio",
            "default": "${serverDist}/taplo lsp stdio"
          }
        }
      }
    }
  }
}
