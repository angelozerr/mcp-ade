{
  "id": "nil-installer",
  "name": "nil",
  "check": {
    "exec": {
      "name": "Check if nil is available",
      "command": "nil --version",
      "timeout": 5000
    }
  },
  "run": {
    "exec": {
      "name": "Install nil via nix",
      "command": "nix profile install nixpkgs#nil",
      "onSuccess": {
        "configureServer": {
          "name": "Configure nil server command",
          "command": "nil"
        }
      }
    }
  }
}
