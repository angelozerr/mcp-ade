{
  "id": "nodejs",
  "name": "Node.js",
  "description": "JavaScript runtime required by Node.js-based language servers",
  "url": "https://nodejs.org",
  "check": {
    "exec": {
      "name": "Check if Node.js is available",
      "command": {
        "windows": "where node",
        "default": "which node"
      },
      "timeout": 5000
    }
  },
  "run": {
    "download": {
      "name": "Download Node.js",
      "nodejs": {
        "release-type": "lts"
      },
      "output": {
        "stripRootDir": true
      },
      "onSuccess": {
        "configureServer": {
          "name": "Configure Node.js",
          "command": {
            "windows": "${serverDist}/node.exe",
            "default": "${serverDist}/bin/node"
          }
        }
      }
    }
  }
}
