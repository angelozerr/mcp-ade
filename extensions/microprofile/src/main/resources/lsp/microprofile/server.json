{
  "id": "microprofile",
  "name": "MicroProfile Language Server",
  "description": "Language server for MicroProfile properties files",
  "url": "https://github.com/eclipse/lsp4mp",
  "runtime": "jdk",
  "acceptContributions": ["classpath"],
  "documentSelector": [
    {
      "language": "java"
    },
    {
      "language": "microprofile-properties"
    },
    {
      "pattern": "**/META-INF/microprofile-config.properties"
    },
    {
      "pattern": "**/application.properties"
    }
  ],
  "configuration": {
    "microprofile.tools.formatting.surroundEqualsWithSpaces": false,
    "microprofile.tools.symbols.showAsTree": true,
    "microprofile.tools.validation.enabled": true,
    "microprofile.tools.validation.duplicate.severity": "warning",
    "microprofile.tools.validation.required.severity": "none",
    "microprofile.tools.validation.unknown.severity": "warning",
    "microprofile.tools.validation.syntax.severity": "error",
    "microprofile.tools.validation.value.severity": "error",
    "microprofile.tools.validation.expression.severity": "error",
    "microprofile.tools.validation.unknown.excluded": [
      "*/mp-rest/providers/*/priority",
      "mp.openapi.schema.*",
      "kafka-streams.*",
      "camel.*"
    ],
    "microprofile.tools.validation.unassigned.excluded": [],
    "microprofile.tools.validation.expression.excluded": [],
    "microprofile.tools.codeLens.urlCodeLensEnabled": true,
    "microprofile.tools.inlayHint.enabled": true,
    "microprofile.tools.inlayHint.converters.enabled": false,
    "microprofile.tools.inlayHint.defaultValues.enabled": true,
    "microprofile.tools.inlayHint.types.enabled": false,
    "microprofile.tools.inlayHint.resolveExpressions.enabled": true
  },
  "contributes": {
    "jdtls": {
      "bundles": ["plugins/*.jar"],
      "bindRequest": [
        "microprofile/java/projectInfo",
		"microprofile/propertyDefinition",
		"microprofile/propertyDocumentation",
        "microprofile/java/codeAction",
		"microprofile/java/codeActionResolve",
        "microprofile/java/codeLens",
        "microprofile/java/completion",
		"microprofile/java/definition",
        "microprofile/java/diagnostics",
		"microprofile/java/hover",
		"microprofile/java/inlayHint",
		"microprofile/java/workspaceSymbols",
        "microprofile/java/fileInfo",
        "microprofile/java/projectLabels",
		"microprofile/java/workspaceLabels"
      ],
	  "bindNotification": [
		"microprofile/propertiesChanged"
	  ]
    }
  }
}
